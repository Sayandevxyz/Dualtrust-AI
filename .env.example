# === AI Providers ===
# Groq API (AI-A: Fast LLM inference - llama3, mixtral)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Mistral API (AI-B: OCR + structuring)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_STRUCT_MODEL=mistral-large-latest

# === Database ===
POSTGRES_USER=dualtrust
POSTGRES_PASSWORD=dualtrust_dev
POSTGRES_DB=dualtrust
DATABASE_URL=postgresql://dualtrust:dualtrust_dev@postgres:5432/dualtrust

# For local dev (outside Docker): 
# DATABASE_URL=postgresql://dualtrust:dualtrust_dev@localhost:5432/dualtrust

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Storage ===
DOCUMENT_STORAGE_PATH=/app/storage/documents
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
STORAGE_ENCRYPTION_KEY=change_me_generate_with_secrets_token_hex_32

# === Feature Flags ===
# Set to false - PAN/Aadhaar/GST external APIs are stubbed for MVP
EXTERNAL_VERIFICATION_ENABLED=false
# Set to true to use RQ async workers; false for synchronous (dev)
ASYNC_ANALYSIS=true

# === App Config ===
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_in_production
JWT_EXPIRE_MINUTES=480

# Set to true to show SYNTHETIC banners in UI, use demo login
DEMO_MODE=true

LOG_LEVEL=INFO

# === Consensus Config ===
CONSENSUS_WEIGHTS_PATH=/app/consensus_weights.json

# === Frontend ===
VITE_API_BASE_URL=http://localhost:8000
VITE_DEMO_MODE=true
